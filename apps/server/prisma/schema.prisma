generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/**
 * Vai trò = một bộ mã quyền `RESOURCE.ACTION` (danh sách hợp lệ ở
 * src/modules/roles/permissions.ts). Mảng chuỗi thay vì bảng nối: thêm quyền mới chỉ là thêm một
 * chuỗi, không cần migration. Không có mã = không có quyền.
 *
 * `isSystem` là vai trò "vua": bỏ qua mọi kiểm tra và không ai sửa/xoá được — phao cứu sinh khi
 * cấu hình sai khoá hết mọi người ra ngoài. Dòng `role_admin` được chèn sẵn trong migration.
 */
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  isSystem    Boolean  @default(false)
  // Tài khoản thuộc vai trò này là một quán: chỉ những tài khoản đó hiện trong các ô chọn/lọc quán
  // (GET /api/users/options). Vai trò chỉ để dùng một chức năng (vd đề xuất chi) để false.
  isShop      Boolean  @default(false)
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  // Bumped on password change so any JWT issued before that moment is rejected —
  // otherwise a stolen cookie would stay valid for its full 7-day life post-reset.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inventoryCounts          InventoryCount[]
  salesOrders              SalesOrder[]
  reorderThresholds        ProductReorderThreshold[]
  stockChecks              StockCheck[]
  materialWastes           MaterialWaste[]
  shiftExpenses            ShiftExpense[]
  costChecks               CostCheck[]               @relation("CostCheckShop")
  costChecksCreated        CostCheck[]               @relation("CostCheckCreatedBy")
  materialTransfersFrom    MaterialTransfer[]        @relation("MaterialTransferFrom")
  materialTransfersTo      MaterialTransfer[]        @relation("MaterialTransferTo")
  materialTransfersCreated MaterialTransfer[]        @relation("MaterialTransferCreatedBy")
  expenseProposals         ExpenseProposal[]         @relation("ExpenseProposalCreatedBy")
  expenseProposalsApproved ExpenseProposal[]         @relation("ExpenseProposalApprovedBy")
  expenseProposalsAdvanced ExpenseProposal[]         @relation("ExpenseProposalAdvancedBy")
  expenseProposalsSpent    ExpenseProposal[]         @relation("ExpenseProposalSpentBy")
  expenseProposalsShop     ExpenseProposal[]         @relation("ExpenseProposalShop")
}

enum DeadlineKind {
  SALES_ORDER
  STOCK_CHECK_WEEKLY
  STOCK_CHECK_MONTHLY
}

/**
 * Lịch hạn nộp, dùng chung cho mọi quán — đúng một dòng cho mỗi loại.
 *
 * Giờ lưu bằng hai cột số nguyên chứ KHÔNG phải DateTime: một mốc giờ đi qua ô nhập
 * datetime-local rồi lưu lại sẽ bị trừ đi phần lệch múi giờ mỗi lần lưu (xem chú thích ở
 * apps/web/src/lib/dateRange.ts), tức "22:00" tụt dần thành 15:00 rồi 08:00.
 */
model Deadline {
  id        String       @id @default(cuid())
  kind      DeadlineKind @unique
  // Thứ phải nộp, 1 = Thứ 2 … 7 = Chủ nhật (ISO-8601). Chỉ dùng cho STOCK_CHECK_WEEKLY.
  weekday   Int?
  // Thứ quy định đi kiểm — mốc MỞ KỲ, cũng chỉ dùng cho STOCK_CHECK_WEEKLY.
  //
  // Không thể suy ra kỳ từ tuần lịch cố định (bắt đầu Thứ 2): nếu quy định kiểm Chủ nhật và hạn
  // nộp Thứ 2, thì Thứ 2 "cùng tuần lịch" lại nằm TRƯỚC ngày kiểm 6 ngày, khiến mọi phiếu đều
  // muộn. Nên kỳ phải mở đúng vào ngày kiểm quy định, và hạn là lần xuất hiện đầu tiên của
  // `weekday` kể từ mốc đó.
  periodWeekday Int?
  // Số ngày ân hạn sau khi kỳ kết thúc. Chỉ dùng cho STOCK_CHECK_MONTHLY (1 = 12h ngày mùng 1
  // tháng sau). SALES_ORDER luôn là trong ngày nên không dùng.
  graceDays Int          @default(0)
  hour      Int
  minute    Int
  updatedAt DateTime     @updatedAt
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  createdAt DateTime @default(now())

  stockImports    StockImport[]
  stockExports    StockExport[]
  salesOrders     SalesOrder[]
  inventoryCounts InventoryCount[]
}

model ProductGroup {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())

  products Product[]
}

model Unit {
  id   String @id @default(cuid())
  code String @unique
  name String

  products              Product[]
  finishedGoodItems     FinishedGoodItem[]
  productsAsRecipeUnit  Product[]              @relation("ProductRecipeUnit")
  supplierPurchaseUnits ProductSupplierPrice[] @relation("SupplierPurchaseUnit")
}

// Nhóm món cho Check Cost (doanh thu/chi phí tách theo nhóm) — để trống với món chưa phân loại.
enum FinishedGoodCategory {
  TRA
  DAV
  // Vật tư/đồ đã pha chế sẵn cần kiểm kê vật lý (ly, ống hút, nắp, nước pha sẵn...) —
  // khác với TRA/DAV vốn là món bán qua POS, chỉ dùng để tính doanh thu Check Cost.
  THANH_PHAM
}

// Catalog of "đồ thành phẩm" (prepared/finished items and supplies checked
// alongside raw materials in a phiếu kiểm kê) — independent of Product, since
// many of these (cups, straws, lids, brewed liquids) aren't raw-material SKUs.
model FinishedGoodItem {
  id           String                @id @default(cuid())
  code         String                @unique
  name         String
  unitId       String
  unit         Unit                  @relation(fields: [unitId], references: [id])
  category     FinishedGoodCategory?
  sellingPrice Decimal?              @db.Decimal(18, 2)
  createdAt    DateTime              @default(now())

  stockCheckFinishedItems    StockCheckFinishedItem[]
  materialWasteFinishedItems MaterialWasteFinishedItem[]
  // Công thức: nguyên liệu + định lượng cần để làm ra 1 đơn vị đồ thành phẩm/món này — dùng cho tính Check Cost.
  recipeItems                FinishedGoodRecipeItem[]
  costCheckSoldItems         CostCheckSoldItem[]
}

// Công thức (BOM): 1 đơn vị của 1 đồ thành phẩm/món cần bao nhiêu nguyên liệu — định lượng luôn tính theo
// Product.recipeUnit (vd Gram), không theo đơn vị chính của nguyên liệu (vd Hộp).
model FinishedGoodRecipeItem {
  id                 String           @id @default(cuid())
  finishedGoodItemId String
  finishedGoodItem   FinishedGoodItem @relation(fields: [finishedGoodItemId], references: [id], onDelete: Cascade)
  productId          String
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityPerUnit    Decimal          @db.Decimal(18, 4)

  @@unique([finishedGoodItemId, productId])
}

// Loại hàng hoá — 5 giá trị cố định trong code, dùng để gộp chi phí cho Check Cost
// (NVL -> chi phí NVL Trà; COC_TAKE -> cốc & ống hút riêng; BANH -> chi phí ĐAV qua công thức
// 1 dòng; DUNG_CU/KHAC -> không tính vào Check Cost). Sửa được bình thường trên từng hàng hoá,
// chỉ 5 tên loại là cố định, không thêm loại mới qua giao diện.
enum ProductType {
  NVL
  COC_TAKE
  BANH
  DUNG_CU
  KHAC
}

model Product {
  id             String       @id @default(cuid())
  code           String       @unique
  name           String
  unitId         String
  unit           Unit         @relation(fields: [unitId], references: [id])
  productGroupId String
  productGroup   ProductGroup @relation(fields: [productGroupId], references: [id])
  costPrice      Decimal      @default(0) @db.Decimal(18, 2)
  type           ProductType  @default(NVL)
  note           String?
  createdAt      DateTime     @default(now())

  // Hàng hoá ngừng dùng (active=false) vẫn giữ nguyên lịch sử, chỉ bị ẩn khỏi các ô chọn hàng
  // hoá khi tạo phiếu/đơn hàng mới — không ảnh hưởng gì tới trang quản lý danh mục (vẫn hiện đủ).
  active         Boolean      @default(true)

  // Quy đổi cho công thức/check cost: 1 [đơn vị chính] = recipeUnitsPerBaseUnit [recipeUnit, vd gam].
  // Để trống nếu công thức dùng thẳng đơn vị chính (hệ số quy đổi = 1).
  recipeUnitId           String?
  recipeUnit             Unit?    @relation("ProductRecipeUnit", fields: [recipeUnitId], references: [id])
  recipeUnitsPerBaseUnit Decimal? @db.Decimal(18, 4)

  // Khối lượng vỏ/bao bì (theo recipeUnit, vd gam) — SL lẻ nhập lúc kiểm kê/huỷ/điều chuyển được
  // coi là cân cả vỏ và tự trừ đi số này trước khi lưu. Để trống nếu hàng hoá không có bao bì đáng kể.
  tareWeight Decimal? @db.Decimal(18, 4)

  stockImportItems      StockImportItem[]
  stockExportItems      StockExportItem[]
  inventoryCountItems   InventoryCountItem[]
  salesOrderItems       SalesOrderItem[]
  reorderThresholds     ProductReorderThreshold[]
  stockCheckItems       StockCheckItem[]
  supplierPrices        ProductSupplierPrice[]
  recipeLines           FinishedGoodRecipeItem[]
  materialWasteItems    MaterialWasteItem[]
  materialTransferItems MaterialTransferItem[]
}

// Per-supplier price list: the same product can be sourced from more than
// one supplier at different import/export prices. Optional — a product with
// no rows here just falls back to Product.costPrice everywhere.
model ProductSupplierPrice {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  importPrice Decimal  @db.Decimal(18, 2)
  exportPrice Decimal  @db.Decimal(18, 2)
  createdAt   DateTime @default(now())

  // Đơn vị gọi NCC (vd Thùng) khi khác đơn vị chính của hàng hoá (vd Hộp) — để trống nghĩa là gọi
  // thẳng theo đơn vị chính. Đối xứng với Product.recipeUnit nhưng quy đổi lên đơn vị lớn hơn:
  // 1 purchaseUnit = baseUnitsPerPurchaseUnit đơn vị chính.
  purchaseUnitId           String?
  purchaseUnit             Unit?    @relation("SupplierPurchaseUnit", fields: [purchaseUnitId], references: [id])
  baseUnitsPerPurchaseUnit Decimal? @db.Decimal(18, 4)
  // Số lượng đặt tối thiểu NCC quy định, tính theo đơn vị gọi ở trên. Null = không ràng buộc.
  minQuantity              Decimal? @db.Decimal(18, 3)
  // Thứ tự ưu tiên gọi NCC cho mặt hàng này: 1 = gọi trước.
  priority                 Int      @default(1)

  @@unique([productId, supplierId])
  @@index([purchaseUnitId])
}

// Per-user reorder thresholds for "Order nhanh": each user has their own
// min/max per product (e.g. different counters/staff restock to different
// levels), so this is scoped by user, not a global Product setting.
model ProductReorderThreshold {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQuantity Decimal  @db.Decimal(18, 3)
  maxQuantity Decimal  @db.Decimal(18, 3)
  createdAt   DateTime @default(now())

  @@unique([userId, productId])
}

model Supplier {
  id      String  @id @default(cuid())
  code    String  @unique
  name    String
  phone   String?
  address String?

  stockImports          StockImport[]
  stockExports          StockExport[]
  productPrices         ProductSupplierPrice[]
  stockExportItems      StockExportItem[]
  materialTransferItems MaterialTransferItem[]
}

model Customer {
  id      String  @id @default(cuid())
  code    String  @unique
  name    String
  phone   String?
  address String?

  stockImports StockImport[]
  stockExports StockExport[]
}

enum StockTransactionStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum StockImportType {
  PURCHASE
  CUSTOMER_RETURN
  TRANSFER_IN
  OTHER
}

enum StockExportType {
  SALE
  SUPPLIER_RETURN
  TRANSFER_OUT
  DAMAGE
  OTHER
}

enum TransactionForm {
  CASH
  BANK_TRANSFER
  DEBT
  OTHER
}

model StockImport {
  id            String                 @id @default(cuid())
  code          String                 @unique
  type          StockImportType        @default(PURCHASE)
  transactionAt DateTime
  form          TransactionForm        @default(CASH)
  status        StockTransactionStatus @default(COMPLETED)
  note          String?
  warehouseId   String
  warehouse     Warehouse              @relation(fields: [warehouseId], references: [id])
  supplierId    String?
  supplier      Supplier?              @relation(fields: [supplierId], references: [id])
  customerId    String?
  customer      Customer?              @relation(fields: [customerId], references: [id])
  createdById   String?
  createdAt     DateTime               @default(now())

  items StockImportItem[]

  @@index([warehouseId, transactionAt])
}

model StockImportItem {
  id            String      @id @default(cuid())
  stockImportId String
  stockImport   StockImport @relation(fields: [stockImportId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  quantity      Decimal     @db.Decimal(18, 3)
  costPrice     Decimal     @db.Decimal(18, 2)
  costAmount    Decimal     @db.Decimal(18, 2)
  note          String?

  @@index([productId])
}

model StockExport {
  id            String                 @id @default(cuid())
  code          String                 @unique
  type          StockExportType        @default(SALE)
  transactionAt DateTime
  form          TransactionForm        @default(CASH)
  status        StockTransactionStatus @default(COMPLETED)
  note          String?
  warehouseId   String
  warehouse     Warehouse              @relation(fields: [warehouseId], references: [id])
  supplierId    String?
  supplier      Supplier?              @relation(fields: [supplierId], references: [id])
  customerId    String?
  customer      Customer?              @relation(fields: [customerId], references: [id])
  salesOrderId  String?                @unique
  salesOrder    SalesOrder?            @relation(fields: [salesOrderId], references: [id])
  createdById   String?
  createdAt     DateTime               @default(now())

  items StockExportItem[]

  @@index([warehouseId, transactionAt])
}

model StockExportItem {
  id            String      @id @default(cuid())
  stockExportId String
  stockExport   StockExport @relation(fields: [stockExportId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  quantity      Decimal     @db.Decimal(18, 3)
  costPrice     Decimal     @db.Decimal(18, 2)
  costAmount    Decimal     @db.Decimal(18, 2)
  note          String?
  // Which supplier this line's cost price came from — picked per line since
  // a single export can cover products normally sourced from different
  // suppliers, unlike an import which is one delivery from one supplier.
  supplierId    String?
  supplier      Supplier?   @relation(fields: [supplierId], references: [id])

  @@index([productId])
}

enum SalesOrderStatus {
  DRAFT
  PENDING_CONFIRM
  CONFIRMED
  SHORT
  COMPLETED
  CANCELLED
}

model SalesOrder {
  id          String           @id @default(cuid())
  code        String           @unique
  warehouseId String
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  orderDate   DateTime         @default(now())
  status      SalesOrderStatus @default(DRAFT)
  note        String?
  createdById String?
  createdBy   User?            @relation(fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  // Lúc completeSalesOrderReceiving chạy xong gần nhất (dù ra SHORT hay COMPLETED) — dùng để lọc
  // "nhận trong kỳ" theo mốc thời gian thực tế nhận hàng, thay vì orderDate (lúc đặt).
  completedAt DateTime?

  // Hạn đặt hàng của chính ngày tạo đơn, chốt ngay lúc tạo. Đo theo createdAt chứ không theo
  // orderDate: orderDate do người đặt tự chọn nên lùi ngày là thoát, createdAt thì không sửa được.
  dueAt       DateTime?
  isLate      Boolean          @default(false)

  items       SalesOrderItem[]
  stockExport StockExport?

  @@index([createdById, completedAt])
}

model SalesOrderItem {
  id               String     @id @default(cuid())
  salesOrderId     String
  salesOrder       SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product    @relation(fields: [productId], references: [id])
  quantity         Decimal    @db.Decimal(18, 3)
  // Receiving checklist: staff ticks each line once received in full; a
  // partially received line can log how much actually arrived instead.
  received         Boolean    @default(false)
  receivedQuantity Decimal?   @db.Decimal(18, 3)
  // Thời điểm CHÍNH DÒNG NÀY thực nhận — Check Cost lọc "nhận trong kỳ" theo mốc này thay vì
  // SalesOrder.completedAt, để đơn nhận rải rác nhiều ngày rơi vào đúng kỳ của từng dòng.
  // Là DateTime chứ không phải ngày trần: mốc kỳ (StockCheck.checkedAt) có cả giờ, ngày trần
  // 00:00 sẽ khiến hàng nhận cùng ngày với phiếu kiểm đầu kỳ bị rơi ra ngoài kỳ.
  receivedAt       DateTime?
  // Lý do admin đổi số lượng lúc xác nhận đơn — hiển thị lại cho nhân viên xem khi đơn ở
  // trạng thái chờ xác nhận (PENDING_CONFIRM).
  note             String?

  @@index([productId])
  @@index([receivedAt])
}

enum InventoryCountStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model InventoryCount {
  id          String               @id @default(cuid())
  code        String               @unique
  warehouseId String
  warehouse   Warehouse            @relation(fields: [warehouseId], references: [id])
  countDate   DateTime
  status      InventoryCountStatus @default(DRAFT)
  note        String?
  createdById String?
  createdBy   User?                @relation(fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())

  items InventoryCountItem[]

  @@index([warehouseId, countDate])
}

model InventoryCountItem {
  id               String         @id @default(cuid())
  inventoryCountId String
  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  actualQuantity   Decimal        @db.Decimal(18, 3)
  note             String?

  @@unique([inventoryCountId, productId])
  @@index([productId])
}

// Simple stock check for staff: just "what's on hand right now" per product,
// no warehouse and no system-vs-actual comparison (that's the separate,
// admin-only InventoryCount feature above). A permanent one-shot log entry —
// no draft/complete workflow, no editing after creation.
// Phiếu kiểm tuần và phiếu kiểm tháng có hạn nộp neo vào hai mốc khác nhau (thứ cố định trong
// tuần vs ngày cuối tháng), nên phải biết phiếu thuộc loại nào mới tính được hạn.
enum StockCheckType {
  WEEKLY
  MONTHLY
}

model StockCheck {
  id          String          @id @default(cuid())
  code        String          @unique
  note        String?
  // Cho phép trống vì phiếu tạo trước khi có chức năng chấm muộn không có thông tin này —
  // những phiếu đó hiển thị "chưa đánh giá" thay vì bị đoán bừa thành đúng hạn.
  type        StockCheckType?
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  // Thời điểm kiểm thực tế do người dùng chọn (mặc định lúc lưu) — dùng làm mốc kỳ Check Cost,
  // khác với createdAt (lúc bản ghi được lưu vào hệ thống).
  checkedAt   DateTime        @default(now())

  // Hạn nộp của KỲ mà phiếu này báo cáo, chốt ngay lúc tạo. Kỳ suy ra từ checkedAt (quán khai
  // kiểm ngày nào), còn hạn thì lấy từ lịch admin đặt — cố tình KHÔNG tính từ checkedAt, nếu
  // không quán chỉ cần khai muộn ngày kiểm là hạn tự lùi theo và luôn đúng hạn.
  dueAt       DateTime?
  // Bằng createdAt > dueAt, nhưng lưu sẵn thành cột riêng để lọc/đánh dấu được bằng SQL.
  isLate      Boolean         @default(false)

  items               StockCheckItem[]
  finishedItems       StockCheckFinishedItem[]
  costChecksAsOpening CostCheck[]              @relation("CostCheckOpening")
  costChecksAsClosing CostCheck[]              @relation("CostCheckClosing")
}

// Nguyên liệu line: tồn chẵn (theo đơn vị chính của hàng hoá) + tồn lẻ (luôn
// tính bằng gam), tách riêng vì đơn vị khác nhau.
model StockCheckItem {
  id            String     @id @default(cuid())
  stockCheckId  String
  stockCheck    StockCheck @relation(fields: [stockCheckId], references: [id], onDelete: Cascade)
  productId     String
  product       Product    @relation(fields: [productId], references: [id])
  wholeQuantity Decimal?   @db.Decimal(18, 3)
  looseQuantity Decimal?   @db.Decimal(18, 3)
  // Đơn giá chốt tại thời điểm kiểm (mặc định lấy từ Product.costPrice, cho sửa tay) — lưu vào
  // phiếu thay vì tính lại lúc xem, để sửa giá vốn sau này không làm đổi số của phiếu đã kiểm.
  // wholePrice theo đơn vị chính, loosePrice theo đơn vị công thức. Thành tiền = SL × giá, tính
  // khi hiển thị chứ không lưu (tránh 2 nguồn sự thật lệch nhau).
  wholePrice    Decimal?   @db.Decimal(18, 2)
  loosePrice    Decimal?   @db.Decimal(18, 2)
  note          String?

  @@unique([stockCheckId, productId])
  @@index([productId])
}

// Đồ thành phẩm line: danh sách độc lập với nguyên liệu (không phải mỗi
// nguyên liệu có 1 đồ thành phẩm tương ứng).
model StockCheckFinishedItem {
  id                 String           @id @default(cuid())
  stockCheckId       String
  stockCheck         StockCheck       @relation(fields: [stockCheckId], references: [id], onDelete: Cascade)
  finishedGoodItemId String
  finishedGoodItem   FinishedGoodItem @relation(fields: [finishedGoodItemId], references: [id])
  quantity           Decimal          @db.Decimal(18, 3)
  // Đơn giá chốt tại thời điểm kiểm — mặc định lấy từ FinishedGoodItem.sellingPrice, cho sửa tay.
  // Chỉ 1 giá vì đồ thành phẩm chỉ kiểm theo 1 đơn vị (không tách chẵn/lẻ như nguyên liệu).
  price              Decimal?         @db.Decimal(18, 2)
  note               String?

  @@unique([stockCheckId, finishedGoodItemId])
}

// Phiếu huỷ nguyên liệu tại quán (nguyên liệu hỏng/đổ bỏ) — cùng kiểu tự phục vụ như
// StockCheck: userId chính là quán (người tạo), không sửa được sau khi tạo.
model MaterialWaste {
  id          String   @id @default(cuid())
  code        String   @unique
  note        String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  // Thời điểm huỷ thực tế do người dùng chọn (mặc định lúc lưu) — dùng làm mốc lọc kỳ Check Cost,
  // khác với createdAt (lúc bản ghi được lưu vào hệ thống).
  wasteAt     DateTime @default(now())

  items         MaterialWasteItem[]
  finishedItems MaterialWasteFinishedItem[]

  @@index([createdById, wasteAt])
}

model MaterialWasteItem {
  id              String        @id @default(cuid())
  materialWasteId String
  materialWaste   MaterialWaste @relation(fields: [materialWasteId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  wholeQuantity   Decimal?      @db.Decimal(18, 3)
  looseQuantity   Decimal?      @db.Decimal(18, 3)
  note            String?

  @@index([productId])
}

// Đồ thành phẩm huỷ — cùng cấu trúc StockCheckFinishedItem (1 số lượng duy nhất, không tách chẵn/lẻ).
model MaterialWasteFinishedItem {
  id                 String           @id @default(cuid())
  materialWasteId    String
  materialWaste      MaterialWaste    @relation(fields: [materialWasteId], references: [id], onDelete: Cascade)
  finishedGoodItemId String
  finishedGoodItem   FinishedGoodItem @relation(fields: [finishedGoodItemId], references: [id])
  quantity           Decimal          @db.Decimal(18, 3)
  note               String?

  @@unique([materialWasteId, finishedGoodItemId])
}

// NVL = nguyên vật liệu (đá, hoa quả…), OTHER = mọi khoản còn lại (ship, sửa chữa…). Chỉ hai loại
// vì quán chỉ cần tách phần chi vào hàng hoá ra khỏi phần chi vận hành.
enum ShiftExpenseType {
  MATERIAL
  OTHER
}

// Sổ chi tại quán ("Chi chốt ca"): mỗi lần chi là MỘT bản ghi phẳng chứ không phải phiếu nhiều
// dòng — quán ghi rải rác trong ca, mỗi khoản có ngày riêng. Nội dung/đơn vị để text tự do vì có
// khoản không nằm trong danh mục hàng hoá (vd "Ship sữa dừa sang Xuân La", đơn vị "lần").
// Không có `code` như các phiếu khác: đây là dòng sổ, không phải chứng từ để tra theo mã.
model ShiftExpense {
  id          String   @id @default(cuid())
  // Ngày chi do quán khai. Kiểu DATE (không có phần giờ) nên không dính lệch múi giờ như DateTime.
  spentAt     DateTime @db.Date
  // Mặc định MATERIAL ở tầng DB chỉ để thêm cột vào bảng đã có dữ liệu cho an toàn — mọi đường ghi
  // (form, API, nhập Excel) đều bắt buộc khai loại, không dựa vào mặc định này.
  type        ShiftExpenseType @default(MATERIAL)
  content     String
  unit        String?
  quantity    Decimal  @db.Decimal(18, 3)
  unitPrice   Decimal  @db.Decimal(18, 2)
  // Thành tiền = SL × đơn giá, tính ở SERVER lúc ghi rồi lưu lại — giống StockImportItem.costAmount.
  // Cố ý lưu (khác StockCheckItem tính lúc hiển thị) vì "Tổng chi" phải cộng trên toàn bộ bộ lọc
  // chứ không chỉ 20 dòng đang hiển thị; có cột này thì dùng thẳng aggregate _sum.
  amount      Decimal  @db.Decimal(18, 2)
  note        String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById, spentAt])
}

enum CostCheckStatus {
  ACTIVE
  CANCELLED
}

// Phiếu Check Cost: đối soát nguyên liệu tiêu hao thực tế (giữa 2 phiếu kiểm kê quán)
// so với tiêu hao theo công thức (từ SL đồ thành phẩm/món đã bán trong kỳ). userId là
// quán được đối soát — khác với createdById vì admin nhập hộ dữ liệu bán hàng cho quán.
model CostCheck {
  id                  String          @id @default(cuid())
  code                String          @unique
  userId              String
  user                User            @relation("CostCheckShop", fields: [userId], references: [id])
  openingStockCheckId String
  openingStockCheck   StockCheck      @relation("CostCheckOpening", fields: [openingStockCheckId], references: [id])
  closingStockCheckId String
  closingStockCheck   StockCheck      @relation("CostCheckClosing", fields: [closingStockCheckId], references: [id])
  note                String?
  // Khuyến mãi/giảm giá trong kỳ, nhập tay theo nhóm — dùng tính doanh thu thuần.
  discountTra         Decimal?        @db.Decimal(18, 2)
  discountDav         Decimal?        @db.Decimal(18, 2)
  // Huỷ mềm — giữ lại lịch sử thay vì xoá hẳn, vd khi phiếu kiểm kê/huỷ/điều chuyển gốc
  // bị sửa và admin muốn tạo lại phiếu Check Cost khác thay cho phiếu này.
  status              CostCheckStatus @default(ACTIVE)
  createdById         String?
  createdBy           User?           @relation("CostCheckCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime        @default(now())
  // Chốt cứng { rows, summary } ngay khi tạo phiếu — sửa giá vốn/giá bán/công thức
  // sau này không được phép làm thay đổi số liệu của phiếu đã tạo.
  reportSnapshot      Json?

  soldItems CostCheckSoldItem[]
}

model CostCheckSoldItem {
  id                 String           @id @default(cuid())
  costCheckId        String
  costCheck          CostCheck        @relation(fields: [costCheckId], references: [id], onDelete: Cascade)
  finishedGoodItemId String
  finishedGoodItem   FinishedGoodItem @relation(fields: [finishedGoodItemId], references: [id])
  quantitySold       Decimal          @db.Decimal(18, 3)

  @@unique([costCheckId, finishedGoodItemId])
}

// Điều chuyển nguyên liệu giữa 2 quán (không qua kho trung tâm) — admin tạo hộ, không có bước
// quán nhận xác nhận lại (tin theo đúng số admin ghi). Ảnh hưởng công thức Check Cost: trừ vào
// quán gửi, cộng vào quán nhận, giống hệt cách "Nhận trong kỳ"/"Đã huỷ" đang được cộng/trừ.
model MaterialTransfer {
  id          String   @id @default(cuid())
  code        String   @unique
  fromUserId  String
  fromUser    User     @relation("MaterialTransferFrom", fields: [fromUserId], references: [id])
  toUserId    String
  toUser      User     @relation("MaterialTransferTo", fields: [toUserId], references: [id])
  transferAt  DateTime @default(now())
  note        String?
  createdById String?
  createdBy   User?    @relation("MaterialTransferCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  items MaterialTransferItem[]

  @@index([fromUserId, transferAt])
  @@index([toUserId, transferAt])
}

model MaterialTransferItem {
  id                 String           @id @default(cuid())
  materialTransferId String
  materialTransfer   MaterialTransfer @relation(fields: [materialTransferId], references: [id], onDelete: Cascade)
  productId          String
  product            Product          @relation(fields: [productId], references: [id])
  wholeQuantity      Decimal?         @db.Decimal(18, 3)
  looseQuantity      Decimal?         @db.Decimal(18, 3)
  // Nguồn giá vốn (để sau này tính doanh thu/chỉ số khác cho Check Cost) — không bắt buộc.
  supplierId         String?
  supplier           Supplier?        @relation(fields: [supplierId], references: [id])
  costPrice          Decimal?         @db.Decimal(18, 2)
  note               String?

  @@index([productId])
}

// Chờ duyệt → Đã duyệt | Từ chối. Sau khi duyệt: người lập tự chi thì bấm thẳng Đã chi; kế toán
// chi thì phải qua Đã tạm ứng rồi mới Đã chi.
enum ExpenseProposalStatus {
  PENDING
  APPROVED
  REJECTED
  ADVANCED
  SPENT
}

enum ExpensePayer {
  CREATOR
  ACCOUNTANT
}

// Phiếu đề xuất chi & tạm ứng: quán xin tiền, admin duyệt. Nội dung / đơn vị là text tự do vì khoản
// xin chi thường không nằm trong danh mục hàng hoá.
model ExpenseProposal {
  id             String                @id @default(cuid())
  code           String                @unique
  status         ExpenseProposalStatus @default(PENDING)
  // Ngày trên phiếu do người lập khai (mặc định hôm nay). Kiểu DATE nên không lệch múi giờ;
  // createdAt mới là lúc lưu thật và không sửa được.
  proposalDate   DateTime              @db.Date
  payer          ExpensePayer
  // Quán chi: tài khoản thuộc vai trò "là quán" (server kiểm lúc ghi). Nullable chỉ vì phiếu cũ lưu
  // tên quán dạng chữ không khớp tài khoản nào — mọi đường ghi mới đều bắt buộc có.
  shopId         String?
  shop           User?                 @relation("ExpenseProposalShop", fields: [shopId], references: [id])
  purpose        String
  // Tổng và tiền tạm ứng tính ở SERVER lúc ghi rồi lưu lại, không tin số client gửi.
  totalAmount    Decimal               @db.Decimal(18, 2)
  // Ba cột tạm ứng chỉ có giá trị khi payer = ACCOUNTANT; người lập tự chi thì luôn null.
  advancePercent Decimal?              @db.Decimal(5, 2)
  advanceAmount  Decimal?              @db.Decimal(18, 2)
  invoiceDueDate DateTime?             @db.Date
  rejectReason   String?
  createdById    String?
  createdBy      User?                 @relation("ExpenseProposalCreatedBy", fields: [createdById], references: [id])
  // Dùng chung cho cả duyệt và từ chối — status cho biết là quyết định nào.
  approvedById   String?
  approvedBy     User?                 @relation("ExpenseProposalApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  advancedById   String?
  advancedBy     User?                 @relation("ExpenseProposalAdvancedBy", fields: [advancedById], references: [id])
  advancedAt     DateTime?
  spentById      String?
  spentBy        User?                 @relation("ExpenseProposalSpentBy", fields: [spentById], references: [id])
  spentAt        DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  items ExpenseProposalItem[]

  @@index([createdById, proposalDate])
  @@index([status])
  @@index([shopId])
}

model ExpenseProposalItem {
  id                String          @id @default(cuid())
  expenseProposalId String
  expenseProposal   ExpenseProposal @relation(fields: [expenseProposalId], references: [id], onDelete: Cascade)
  sortOrder         Int
  content           String
  unitPrice         Decimal         @db.Decimal(18, 2)
  unit              String?
  quantity          Decimal         @db.Decimal(18, 3)
  amount            Decimal         @db.Decimal(18, 2)
  note              String?

  @@index([expenseProposalId, sortOrder])
}
