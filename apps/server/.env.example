DATABASE_URL="postgresql://kho_user:kho_pass@localhost:5432/kho_db?schema=public"
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="7d"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
COOKIE_NAME="kho_token"
NODE_ENV="development"
# OAuth Client ID (loại Web) từ Google Cloud Console — bỏ trống thì tắt đăng nhập Google
GOOGLE_CLIENT_ID=""
# Cloudflare R2 để lưu ảnh chứng từ của Chi chốt ca — bỏ trống thì tắt tính năng đính ảnh.
# Bucket phải tạo sẵn trên dashboard R2 và để private; token chỉ cần quyền Object Read & Write.
R2_ACCOUNT_ID=""
R2_BUCKET_NAME=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Local để false: token của điện thoại cài bản thật vẫn nằm trong DB local nên sẽ nhận nhầm thông báo
# của dữ liệu thử. Trên Render bỏ trống = bật.
PUSH_ENABLED="false"
