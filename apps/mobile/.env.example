# URL API, gồm /api (để trống khi dùng API qua IP LAN trong development).
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api
# OAuth client loại Web, trùng GOOGLE_CLIENT_ID của server; KHÔNG dùng client Android.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# URL HTTPS của trang chính sách đã công bố trên web. Cấu hình thêm trên EAS trước khi build.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://quanlykhoindoor.vercel.app/privacy-policy
